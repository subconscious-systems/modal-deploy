# Copy this file to .env and fill in the values. .env is gitignored.
#
# write_secrets.py upserts Modal secrets from the credential block below.
# deploy.py only reads DOCKER_TOKEN_SECRET + ORANGELINE_IMAGE_NAME.
#
# Modal secret *names* use the SUBCONSCIOUS_* namespace; the *keys* inside
# are the names consumers expect (HF_TOKEN; REGISTRY_USERNAME/REGISTRY_PASSWORD).

# ---------------------------------------------------------------------------
# write_secrets.py
# ---------------------------------------------------------------------------

# Hugging Face token — gated nvidia/GLM-5.2-NVFP4 + DFLASH draft.
# Create at: https://huggingface.co/settings/tokens
SUBCONSCIOUS_HF_TOKEN=

# Docker Hub — upserts Modal secret SUBCONSCIOUS_DOCKERHUB
#   { REGISTRY_USERNAME, REGISTRY_PASSWORD }
# Token: Read permission is enough to pull.
# Create at: https://hub.docker.com/settings/security
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=

# distr (registry.distr.sh) — upserts Modal secret SUBCONSCIOUS_DISTR_HUB
#   { REGISTRY_USERNAME, REGISTRY_PASSWORD }
# Both must be set to upsert. Login convention is usually username "-".
DISTR_USERNAME=-
DISTR_TOKEN=

# ---------------------------------------------------------------------------
# deploy.py — which image to pull, and which of the two registry secrets to use
# ---------------------------------------------------------------------------

# Modal secret name: SUBCONSCIOUS_DOCKERHUB or SUBCONSCIOUS_DISTR_HUB
DOCKER_TOKEN_SECRET=SUBCONSCIOUS_DOCKERHUB

# Serve image. Docker Hub default:
ORANGELINE_IMAGE_NAME=subconsciouslabs/sglang-baseten:sm_100-v0.10
# distr:
# ORANGELINE_IMAGE_NAME=registry.distr.sh/subconscious/timrun:sm_100-v0.10
