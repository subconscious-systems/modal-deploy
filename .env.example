# Copy this file to .env and fill in the values. .env is gitignored.
#
# Raw sensitive values, sourced by write_secrets.py, which upserts them into
# Modal as the secrets SUBCONSCIOUS_HF_TOKEN and SUBCONSCIOUS_DOCKERHUB.
# The Modal secret *names* use the SUBCONSCIOUS_* namespace; the *keys* inside
# are the names consumers expect (HF_TOKEN; REGISTRY_USERNAME/REGISTRY_PASSWORD).

# Hugging Face token — access to gated nvidia/GLM-5.2-NVFP4 and the
# SubconsciousDev/glm-5.2-fp8-dflash-v2 draft model.
# Create at: https://huggingface.co/settings/tokens
SUBCONSCIOUS_HF_TOKEN=

# Docker Hub — auth for the private serve image
# (subconsciouslabs/sglang-baseten:sm_100-v0.10). Username is your Hub
# account; password is an access token (Read permission is enough to pull).
# Create at: https://hub.docker.com/settings/security
SUBCONSCIOUS_DOCKERHUB_USERNAME=
SUBCONSCIOUS_DOCKERHUB_TOKEN=
