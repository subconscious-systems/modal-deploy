# Copy this file to .env and fill in the values. .env is gitignored.
#
# write_secrets.py upserts Modal secrets from the credential block below.
# deploy.py reads DOCKER_TOKEN_SECRET + ORANGELINE_IMAGE_NAME.
#
# Modal secret *names* use the SUBCONSCIOUS_* namespace; the *keys* inside
# are the names consumers expect (HF_TOKEN; REGISTRY_USERNAME/REGISTRY_PASSWORD).

# ---------------------------------------------------------------------------
# write_secrets.py
# ---------------------------------------------------------------------------

# Hugging Face token — zai-org/GLM-5.2-FP8 + gated DFLASH draft.
# Create at: https://huggingface.co/settings/tokens
SUBCONSCIOUS_HF_TOKEN=

# Docker Hub — upserts Modal secret SUBCONSCIOUS_DOCKERHUB
#   { REGISTRY_USERNAME, REGISTRY_PASSWORD }
# Token: Read permission is enough to pull.
# Create at: https://hub.docker.com/settings/security
DOCKERHUB_USERNAME=subconsciouslabs
DOCKERHUB_TOKEN=your-oat

# ---------------------------------------------------------------------------
# deploy.py
# ---------------------------------------------------------------------------

# Modal secret name with REGISTRY_USERNAME / REGISTRY_PASSWORD
DOCKER_TOKEN_SECRET=SUBCONSCIOUS_DOCKERHUB

# Serve image on Docker Hub
ORANGELINE_IMAGE_NAME=subconsciouslabs/enter-image-tag-here
