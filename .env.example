# Copy this file to .env and fill in the values. .env is gitignored.
#
# Raw sensitive values, sourced by write_secrets.py, which upserts them into
# Modal as the secrets SUBCONSCIOUS_HF_TOKEN and SUBCONSCIOUS_DISTR_PAT.
# The Modal secret *names* use the SUBCONSCIOUS_* namespace; the *keys* inside
# are the names consumers expect (HF_TOKEN; REGISTRY_USERNAME/REGISTRY_PASSWORD).

# Hugging Face token — access to gated nvidia/GLM-5.2-NVFP4 and the
# SubconsciousDev/glm-5.2-fp8-dflash-v2 draft model.
# Create at: https://huggingface.co/settings/tokens
SUBCONSCIOUS_HF_TOKEN=

# Distr PAT — auth for registry.distr.sh (pulls the timrun sm_100 image).
# Generate in distr. The username is the literal "-" (added automatically by
# write_secrets.py, so it isn't stored here).
SUBCONSCIOUS_DISTR_PAT=
